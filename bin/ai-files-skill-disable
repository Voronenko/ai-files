#!/usr/bin/env bash
#
# ai-files-skill-disable - Disable a Claude Code skill by removing symlinks
#
# This script removes symlinks from .claude/skills/ and/or .kilo/skills/ or .opencode/skills/
#
# Usage: ai-files-skill-disable <skill-name> [OPTIONS]

set -euo pipefail

readonly EXIT_SUCCESS=0
readonly EXIT_INVALID_SKILL=1
readonly EXIT_NOT_LINKED=1
readonly EXIT_PERMISSION=2
readonly EXIT_ERROR=3

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Resolve script location
SCRIPT_PATH="$0"
while [ -h "$SCRIPT_PATH" ]; do
    DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$DIR/$SCRIPT_PATH"
done
SELF_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
PROJECT_ROOT="$(cd "$SELF_DIR/.." && pwd)"

# Command-line options
CLAUDE_ONLY=false
KILO_ONLY=false
OPENCODE_ONLY=false
SKILL_NAME=""

error() {
    echo -e "${RED}Error:${NC} $1" >&2
}

success() {
    echo -e "${GREEN}✓${NC} $1"
}

info() {
    echo "  $1"
}

show_help() {
    cat <<EOF
Usage: ai-files skill disable <skill-name> [OPTIONS]

Disable a Claude Code skill by removing symlinks from target directories.

Arguments:
  skill-name              Name of the skill to disable (required)

Options:
  --claude-only           Disable only for Claude (.claude/skills/)
  --kilo-only            Disable only for Kilo (.kilo/skills/)
  --opencode-only         Disable only for OpenCode (.opencode/skills/)
  -h, --help             Show this help message

Examples:
  ai-files skill disable adr-tools
  ai-files skill disable lnav --claude-only
  ai-files skill disable graphify --kilo-only

This only removes symlinks; the skill source files in .ai-files/skills/
or .ai-files/dotclaude/skills/ are preserved.
EOF
}

find_skill_source() {
    local skill="$1"

    # Try exact qualified path under .ai-files/skills/ (handles top-level and nested)
    if [ -d "$PROJECT_ROOT/.ai-files/skills/$skill" ] && [ -f "$PROJECT_ROOT/.ai-files/skills/$skill/SKILL.md" ]; then
        echo "$PROJECT_ROOT/.ai-files/skills/$skill"
        return
    fi

    # Try dotclaude
    if [ -d "$PROJECT_ROOT/.ai-files/dotclaude/skills/$skill" ] && [ -f "$PROJECT_ROOT/.ai-files/dotclaude/skills/$skill/SKILL.md" ]; then
        echo "$PROJECT_ROOT/.ai-files/dotclaude/skills/$skill"
        return
    fi

    # Search recursively by leaf name (for backwards compatibility)
    local matches=()
    while IFS= read -r -d '' skill_md; do
        local dir
        dir=$(dirname "$skill_md")
        local leaf
        leaf=$(basename "$dir")
        if [ "$leaf" = "$skill" ]; then
            matches+=("$dir")
        fi
    done < <(find "$PROJECT_ROOT/.ai-files/skills" -name 'SKILL.md' -not -path '*/.git/*' -print0 2>/dev/null)

    if [ ${#matches[@]} -eq 1 ]; then
        echo "${matches[0]}"
        return
    elif [ ${#matches[@]} -gt 1 ]; then
        error "Multiple matches for '$skill'. Use qualified path:"
        for m in "${matches[@]}"; do
            local rel="${m#$PROJECT_ROOT/.ai-files/skills/}"
            echo "  - $rel" >&2
        done
        echo ""
        return
    fi

    echo ""
}

disable_skill_in_dir() {
    local source_path="$1"
    local target_dir="$2"
    local agent_name
    agent_name=$(basename "$target_dir")

    if [ ! -d "$target_dir" ]; then
        info "No $agent_name skills directory"
        return 1
    fi

    # Find symlink whose resolved target matches source_path
    local found=false
    for link in "$target_dir"/*; do
        [ -L "$link" ] || continue
        local resolved
        resolved=$(readlink -f "$link" 2>/dev/null || true)
        if [ "$resolved" = "$source_path" ]; then
            rm -f "$link" 2>/dev/null || {
                error "Failed to remove symlink from $agent_name"
                return "$EXIT_ERROR"
            }
            local rel_path="${link#"$PROJECT_ROOT/"}"
            success "Removed $rel_path"
            found=true
            break
        fi
    done

    if [[ "$found" == false ]]; then
        info "Not linked in $agent_name"
        return 1
    fi

    return 0
}

parse_arguments() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            --claude-only)
                CLAUDE_ONLY=true
                ;;
            --kilo-only)
                KILO_ONLY=true
                ;;
            --opencode-only)
                OPENCODE_ONLY=true
                ;;
            -h|--help)
                show_help
                exit "$EXIT_SUCCESS"
                ;;
            -*)
                error "Unknown option: $1"
                show_help
                exit "$EXIT_ERROR"
                ;;
            *)
                if [ -z "$SKILL_NAME" ]; then
                    SKILL_NAME="$1"
                else
                    error "Unexpected argument: $1"
                    show_help
                    exit "$EXIT_ERROR"
                fi
                ;;
        esac
        shift
    done

    if [ -z "$SKILL_NAME" ]; then
        error "Skill name is required"
        show_help
        exit "$EXIT_ERROR"
    fi

    if [[ "$CLAUDE_ONLY" == true ]] && [[ "$KILO_ONLY" == true ]]; then
        error "Options --claude-only and --kilo-only are mutually exclusive"
        exit "$EXIT_ERROR"
    fi

    if [[ "$CLAUDE_ONLY" == true ]] && [[ "$OPENCODE_ONLY" == true ]]; then
        error "Options --claude-only and --opencode-only are mutually exclusive"
        exit "$EXIT_ERROR"
    fi

    if [[ "$KILO_ONLY" == true ]] && [[ "$OPENCODE_ONLY" == true ]]; then
        error "Options --kilo-only and --opencode-only are mutually exclusive"
        exit "$EXIT_ERROR"
    fi
}

main() {
    parse_arguments "$@"

    # Find skill source
    local skill_source
    skill_source=$(find_skill_source "$SKILL_NAME")

    if [ -z "$skill_source" ]; then
        error "Skill not found: $SKILL_NAME"
        exit "$EXIT_INVALID_SKILL"
    fi

    echo "Disabling skill: $SKILL_NAME"

    local claude_disabled=false
    local kilo_disabled=false
    local opencode_disabled=false

    # Disable in Claude
    if [[ "$KILO_ONLY" != true ]] && [[ "$OPENCODE_ONLY" != true ]]; then
        if disable_skill_in_dir "$skill_source" "$PROJECT_ROOT/.claude/skills"; then
            claude_disabled=true
        fi
    fi

    # Disable in Kilo
    if [[ "$CLAUDE_ONLY" != true ]] && [[ "$OPENCODE_ONLY" != true ]]; then
        if disable_skill_in_dir "$skill_source" "$PROJECT_ROOT/.kilo/skills"; then
            kilo_disabled=true
        fi
    fi

    # Disable in OpenCode
    if [[ "$CLAUDE_ONLY" != true ]] && [[ "$KILO_ONLY" != true ]]; then
        if disable_skill_in_dir "$skill_source" "$PROJECT_ROOT/.opencode/skills"; then
            opencode_disabled=true
        fi
    fi

    echo ""

    # Check if anything was disabled
    if [[ "$claude_disabled" == false ]] && [[ "$kilo_disabled" == false ]] && [[ "$opencode_disabled" == false ]]; then
        info "Skill was not linked in any target directory"
        exit "$EXIT_SUCCESS"
    fi

    success "Skill disabled successfully"
}

main "$@"
