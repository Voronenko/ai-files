#!/usr/bin/env bash
#
# ai-files-skills-sync - Sync skills from agents.yaml to agent dot directories
#
# Reads agents.yaml from the repo root and enables all listed skills in
# .claude/skills/, .kilo/skills/, and .opencode/skills/ (for agents present).
#
# Usage: ai-files skills sync [OPTIONS]

set -euo pipefail

readonly EXIT_SUCCESS=0
readonly EXIT_PARTIAL=1
readonly EXIT_ERROR=2

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

SCRIPT_PATH="$0"
while [ -h "$SCRIPT_PATH" ]; do
    DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$DIR/$SCRIPT_PATH"
done
SELF_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
PROJECT_ROOT="$(cd "$SELF_DIR/.." && pwd)"

DRY_RUN=false

error() {
    echo -e "${RED}Error:${NC} $1" >&2
}

warn() {
    echo -e "${YELLOW}Warning:${NC} $1" >&2
}

success() {
    echo -e "${GREEN}✓${NC} $1"
}

show_help() {
    cat <<EOF
Usage: ai-files skills sync [OPTIONS]

Sync skills from agents.yaml to agent dot directories.

Reads the default_skills list from agents.yaml and enables each skill
in .claude/skills/, .kilo/skills/, and .opencode/skills/ for agents
that are present in the project.

Options:
  --dry-run              Show what would be synced without making changes
  -h, --help             Show this help message

agents.yaml format:
  default_skills:
    - skill-name          # Unqualified name or qualified path
    - ag-kit/brainstorming  # Nested skills use qualified path

Skills are resolved from .ai-files/skills/ or .ai-files/dotclaude/skills/.
If an agent directory (.claude/, .kilo/, .opencode/) is missing, it is
skipped with a notice.

Examples:
  ai-files skills sync
  ai-files skills sync --dry-run
EOF
}

parse_agents_yaml() {
    local yaml_file="$1"

    awk '/^default_skills:/ {in_block=1; next}
         in_block && /^[a-zA-Z]/ {exit}
         in_block && /^  - / {sub(/^  - /, ""); print}' "$yaml_file"
}

find_skill_source() {
    local skill="$1"

    # Try exact qualified path under .ai-files/skills/
    if [ -d "$PROJECT_ROOT/.ai-files/skills/$skill" ] && [ -f "$PROJECT_ROOT/.ai-files/skills/$skill/SKILL.md" ]; then
        echo "$PROJECT_ROOT/.ai-files/skills/$skill"
        return
    fi

    # Try dotclaude
    if [ -d "$PROJECT_ROOT/.ai-files/dotclaude/skills/$skill" ] && [ -f "$PROJECT_ROOT/.ai-files/dotclaude/skills/$skill/SKILL.md" ]; then
        echo "$PROJECT_ROOT/.ai-files/dotclaude/skills/$skill"
        return
    fi

    # Search recursively by leaf name (backwards compat for plain names)
    local matches=()
    while IFS= read -r -d '' skill_md; do
        local dir
        dir=$(dirname "$skill_md")
        local leaf
        leaf=$(basename "$dir")
        if [ "$leaf" = "$skill" ]; then
            matches+=("$dir")
        fi
    done < <(find "$PROJECT_ROOT/.ai-files/skills" -name 'SKILL.md' -not -path '*/.git/*' -print0 2>/dev/null)

    if [ ${#matches[@]} -eq 1 ]; then
        echo "${matches[0]}"
    elif [ ${#matches[@]} -gt 1 ]; then
        echo "AMBIGUOUS"
    fi
}

check_enabled() {
    local source_path="$1"
    local agent_name="$2"
    local leaf="${source_path##*/}"
    local link="$PROJECT_ROOT/.$agent_name/skills/$leaf"

    if [ -L "$link" ]; then
        local resolved
        resolved=$(readlink -f "$link" 2>/dev/null || true)
        [ "$resolved" = "$source_path" ] && return 0
    fi
    return 1
}

generate_example_yaml() {
    local claude_skills="$PROJECT_ROOT/.claude/skills"

    echo "# Default skills to link to .claude/, .kilo/, and .opencode/ directories"
    echo "# Generated from currently enabled skills in .claude/skills/"
    echo "default_skills:"

    local count=0
    if [ -d "$claude_skills" ]; then
        for link in "$claude_skills"/*; do
            [ -L "$link" ] || continue

            local resolved
            resolved=$(readlink -f "$link" 2>/dev/null || true)
            [ -n "$resolved" ] || continue

            # Only include if the resolved target has a SKILL.md
            [ -f "$resolved/SKILL.md" ] || continue

            # Derive qualified name: strip .ai-files/skills/ or .ai-files/dotclaude/skills/ prefix
            local sk_dir="$PROJECT_ROOT/.ai-files/skills/"
            local dc_dir="$PROJECT_ROOT/.ai-files/dotclaude/skills/"
            local qualified

            if [[ "$resolved" == "$sk_dir"* ]]; then
                qualified="${resolved#$sk_dir}"
            elif [[ "$resolved" == "$dc_dir"* ]]; then
                qualified="${resolved#$dc_dir}"
            else
                qualified=$(basename "$resolved")
            fi

            echo "  - $qualified"
            ((count++)) || true
        done
    fi

    if [ "$count" -eq 0 ]; then
        echo "  # No enabled skills found in .claude/skills/"
        echo "  # - skill-name"
    fi
}

main() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            --dry-run)
                DRY_RUN=true
                ;;
            -h|--help)
                show_help
                exit "$EXIT_SUCCESS"
                ;;
            *)
                error "Unknown option: $1"
                show_help
                exit "$EXIT_ERROR"
                ;;
        esac
        shift
    done

    local yaml="$PROJECT_ROOT/agents.yaml"
    if [ ! -f "$yaml" ]; then
        error "agents.yaml not found at $yaml"
        echo "" >&2
        echo "Example based on currently enabled skills in .claude/skills/:" >&2
        generate_example_yaml >&2
        exit "$EXIT_ERROR"
    fi

    # Parse skill list from yaml
    local skills=()
    while IFS= read -r skill; do
        [ -n "$skill" ] && skills+=("$skill")
    done < <(parse_agents_yaml "$yaml")

    if [ ${#skills[@]} -eq 0 ]; then
        echo "No skills listed in agents.yaml (all commented out or empty list)"
        exit "$EXIT_SUCCESS"
    fi

    # Resolve skill names to source paths
    local resolved=()
    local warnings=0
    local src
    for skill in "${skills[@]}"; do
        src=$(find_skill_source "$skill")

        if [ -z "$src" ]; then
            warn "Skill not found: $skill (skipping)"
            ((warnings++)) || true
        elif [ "$src" = "AMBIGUOUS" ]; then
            warn "Ambiguous name: $skill — use qualified path (e.g. ag-kit/brainstorming), skipping"
            ((warnings++)) || true
        else
            resolved+=("$skill:$src")
        fi
    done

    if [ ${#resolved[@]} -eq 0 ]; then
        error "No valid skills to sync"
        exit "$EXIT_ERROR"
    fi

    local agents=("claude" "kilo" "opencode")
    local total_synced=0
    local agent_count=0

    local prefix=""
    [[ "$DRY_RUN" == true ]] && prefix="DRY RUN: "

    echo ""
    echo "${prefix}Syncing ${#resolved[@]} skill(s) from agents.yaml"
    echo ""

    for agent in "${agents[@]}"; do
        local agent_root="$PROJECT_ROOT/.$agent"

        if [ ! -d "$agent_root" ]; then
            echo -e "${CYAN}── $agent${NC}"
            echo "  ! No .$agent/ directory, skipping"
            echo ""
            continue
        fi

        ((agent_count++)) || true
        echo -e "${CYAN}── $agent (.$agent/)${NC}"

        local agent_synced=0
        for entry in "${resolved[@]}"; do
            local skill_name="${entry%%:*}"
            local src="${entry#*:}"
            local leaf="${src##*/}"

            if check_enabled "$src" "$agent"; then
                echo "  ✓ $skill_name (already enabled)"
                [[ "$DRY_RUN" == false ]] && ((agent_synced++)) || true
            elif [[ "$DRY_RUN" == true ]]; then
                echo "  + $skill_name → .$agent/skills/$leaf"
            else
                local enable_out
                if enable_out=$("$SELF_DIR/ai-files-skill-enable" "$skill_name" "--${agent}-only" 2>&1); then
                    echo "  ✓ $skill_name (created)"
                    ((agent_synced++)) || true
                else
                    echo "  ✗ $skill_name (failed)"
                    echo "$enable_out" | while IFS= read -r line; do
                        echo "      $line"
                    done
                    ((warnings++)) || true
                fi
            fi
        done
        total_synced=$((total_synced + agent_synced))
        echo ""
    done

    echo "─── Summary ───"
    if [[ "$DRY_RUN" == true ]]; then
        echo "  No changes made (dry run)"
    else
        echo "  Enabled: $total_synced skill(s) across $agent_count agent(s)"
    fi
    if [ "$warnings" -gt 0 ]; then
        echo "  Warnings: $warnings"
    fi
    echo ""

    if [ "$warnings" -gt 0 ]; then
        exit "$EXIT_PARTIAL"
    fi
    exit "$EXIT_SUCCESS"
}

main "$@"
