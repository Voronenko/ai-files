#!/usr/bin/env bash
#
# ai-files-skill-enable - Enable a Claude Code skill by creating symlinks
#
# This script creates symlinks from .claude/skills/ and/or .kilo/skills/ or .opencode/skills/
# or .agents/skills/ to skills in .ai-files/skills/ or .ai-files/dotclaude/skills/
#
# Usage: ai-files-skill-enable <skill-name> [OPTIONS]

set -euo pipefail

readonly EXIT_SUCCESS=0
readonly EXIT_INVALID_SKILL=1
readonly EXIT_PERMISSION=2
readonly EXIT_ERROR=3

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

# Resolve script location
SCRIPT_PATH="$0"
while [ -h "$SCRIPT_PATH" ]; do
    DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$DIR/$SCRIPT_PATH"
done
SELF_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
PROJECT_ROOT="$(cd "$SELF_DIR/.." && pwd)"

# Command-line options
CLAUDE_ONLY=false
KILO_ONLY=false
OPENCODE_ONLY=false
AGENTS_ONLY=false
SKILL_NAME=""

error() {
    echo -e "${RED}Error:${NC} $1" >&2
}

success() {
    echo -e "${GREEN}✓${NC} $1"
}

info() {
    echo "  $1"
}

show_help() {
    cat <<EOF
Usage: ai-files skill enable <skill-name> [OPTIONS]

Enable a Claude Code skill by creating symlinks in target directories.

Arguments:
  skill-name              Name of the skill to enable (required)

Options:
  --claude-only           Enable only for Claude (.claude/skills/)
  --kilo-only            Enable only for Kilo (.kilo/skills/)
  --opencode-only         Enable only for OpenCode (.opencode/skills/)
  --agents-only           Enable only for Agents (.agents/skills/)
  -h, --help             Show this help message

Examples:
  ai-files skill enable adr-tools
  ai-files skill enable lnav --claude-only
  ai-files skill enable graphify --kilo-only
  ai-files skill enable workout --agents-only

Skills are sourced from:
  - .ai-files/skills/
  - .ai-files/dotclaude/skills/
EOF
}

find_skill_source() {
    local skill="$1"

    # Try exact qualified path under .ai-files/skills/ (handles top-level and nested)
    if [ -d "$PROJECT_ROOT/.ai-files/skills/$skill" ] && [ -f "$PROJECT_ROOT/.ai-files/skills/$skill/SKILL.md" ]; then
        echo "$PROJECT_ROOT/.ai-files/skills/$skill"
        return
    fi

    # Try dotclaude
    if [ -d "$PROJECT_ROOT/.ai-files/dotclaude/skills/$skill" ] && [ -f "$PROJECT_ROOT/.ai-files/dotclaude/skills/$skill/SKILL.md" ]; then
        echo "$PROJECT_ROOT/.ai-files/dotclaude/skills/$skill"
        return
    fi

    # Search recursively by leaf name (for backwards compatibility with plain names)
    local matches=()
    while IFS= read -r -d '' skill_md; do
        local dir
        dir=$(dirname "$skill_md")
        local leaf
        leaf=$(basename "$dir")
        if [ "$leaf" = "$skill" ]; then
            matches+=("$dir")
        fi
    done < <(find "$PROJECT_ROOT/.ai-files/skills" -name 'SKILL.md' -not -path '*/.git/*' -print0 2>/dev/null)

    if [ ${#matches[@]} -eq 1 ]; then
        echo "${matches[0]}"
        return
    elif [ ${#matches[@]} -gt 1 ]; then
        error "Multiple matches for '$skill'. Use qualified path:"
        for m in "${matches[@]}"; do
            local rel="${m#$PROJECT_ROOT/.ai-files/skills/}"
            echo "  - $rel" >&2
        done
        echo ""
        return
    fi

    echo ""
}

get_symlink_target() {
    local source_path="$1"
    local target_dir="$2"

    realpath --relative-to="$target_dir" "$source_path"
}

enable_skill_in_dir() {
    local source_path="$2"
    local target_dir="$3"
    local leaf_name="${source_path##*/}"
    local target_path="$target_dir/$leaf_name"

    # Create target directory if it doesn't exist
    if [ ! -d "$target_dir" ]; then
        mkdir -p "$target_dir" 2>/dev/null || {
            error "Cannot create target directory: $target_dir"
            return "$EXIT_PERMISSION"
        }
    fi

    # Check if symlink already exists
    if [ -L "$target_path" ]; then
        if [ -e "$target_path" ]; then
            local resolved
            resolved=$(readlink -f "$target_path" 2>/dev/null || true)
            if [ "$resolved" = "$source_path" ]; then
                info "Already enabled: ${target_path#"$PROJECT_ROOT/"}"
                return 0
            else
                info "Replacing: ${target_path#"$PROJECT_ROOT/"} was pointing to ${resolved#"$PROJECT_ROOT/"}"
                rm -f "$target_path" 2>/dev/null || true
            fi
        else
            # Broken symlink, remove it
            rm -f "$target_path" 2>/dev/null || true
        fi
    elif [ -e "$target_path" ]; then
        error "Path exists but is not a symlink: $target_path"
        return "$EXIT_ERROR"
    fi

    # Get relative symlink target
    local relative_target
    relative_target=$(get_symlink_target "$source_path" "$target_dir")

    # Create symlink
    ln -s "$relative_target" "$target_path" 2>/dev/null || {
        error "Failed to create symlink in $(basename "$target_dir")"
        return "$EXIT_ERROR"
    }

    local rel_path="${target_path#"$PROJECT_ROOT/"}"
    success "Created $rel_path"
    return 0
}

parse_arguments() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            --claude-only)
                CLAUDE_ONLY=true
                ;;
            --kilo-only)
                KILO_ONLY=true
                ;;
            --opencode-only)
                OPENCODE_ONLY=true
                ;;
            --agents-only)
                AGENTS_ONLY=true
                ;;
            -h|--help)
                show_help
                exit "$EXIT_SUCCESS"
                ;;
            -*)
                error "Unknown option: $1"
                show_help
                exit "$EXIT_ERROR"
                ;;
            *)
                if [ -z "$SKILL_NAME" ]; then
                    SKILL_NAME="$1"
                else
                    error "Unexpected argument: $1"
                    show_help
                    exit "$EXIT_ERROR"
                fi
                ;;
        esac
        shift
    done

    if [ -z "$SKILL_NAME" ]; then
        error "Skill name is required"
        show_help
        exit "$EXIT_ERROR"
    fi

    local only_count=0
    if [[ "$CLAUDE_ONLY" == true ]]; then only_count=$((only_count + 1)); fi
    if [[ "$KILO_ONLY" == true ]]; then only_count=$((only_count + 1)); fi
    if [[ "$OPENCODE_ONLY" == true ]]; then only_count=$((only_count + 1)); fi
    if [[ "$AGENTS_ONLY" == true ]]; then only_count=$((only_count + 1)); fi
    if [ "$only_count" -gt 1 ]; then
        error "Options --claude-only, --kilo-only, --opencode-only, and --agents-only are mutually exclusive"
        exit "$EXIT_ERROR"
    fi
}

main() {
    parse_arguments "$@"

    # Find skill source
    local skill_source
    skill_source=$(find_skill_source "$SKILL_NAME")

    if [ -z "$skill_source" ]; then
        error "Skill not found: $SKILL_NAME"
        echo "" >&2
        echo "Available skills:" >&2
        find "$PROJECT_ROOT/.ai-files/skills" -name 'SKILL.md' -not -path '*/.git/*' -printf '%h\n' 2>/dev/null | sed "s|$PROJECT_ROOT/.ai-files/skills/||" | while read -r skill; do
            [ -z "$skill" ] && continue
            echo "  - $skill" >&2
        done
        find "$PROJECT_ROOT/.ai-files/dotclaude/skills" -mindepth 1 -maxdepth 1 -type d -not -name ".*" -exec basename {} \; 2>/dev/null | while read -r skill; do
            echo "  - $skill" >&2
        done
        echo "" >&2
        echo "Tip: Use qualified path for nested skills (e.g. ag-kit/brainstorming)" >&2
        exit "$EXIT_INVALID_SKILL"
    fi

    echo "Enabling skill: $SKILL_NAME"

    # Enable in Claude
    if [[ "$KILO_ONLY" != true ]] && [[ "$OPENCODE_ONLY" != true ]] && [[ "$AGENTS_ONLY" != true ]]; then
        enable_skill_in_dir "$SKILL_NAME" "$skill_source" "$PROJECT_ROOT/.claude/skills"
    fi

    # Enable in Kilo
    if [[ "$CLAUDE_ONLY" != true ]] && [[ "$OPENCODE_ONLY" != true ]] && [[ "$AGENTS_ONLY" != true ]]; then
        enable_skill_in_dir "$SKILL_NAME" "$skill_source" "$PROJECT_ROOT/.kilo/skills"
    fi

    # Enable in OpenCode
    if [[ "$CLAUDE_ONLY" != true ]] && [[ "$KILO_ONLY" != true ]] && [[ "$AGENTS_ONLY" != true ]]; then
        enable_skill_in_dir "$SKILL_NAME" "$skill_source" "$PROJECT_ROOT/.opencode/skills"
    fi

    # Enable in Agents
    if [[ "$CLAUDE_ONLY" != true ]] && [[ "$KILO_ONLY" != true ]] && [[ "$OPENCODE_ONLY" != true ]]; then
        enable_skill_in_dir "$SKILL_NAME" "$skill_source" "$PROJECT_ROOT/.agents/skills"
    fi

    echo ""
    success "Skill enabled successfully"
}

main "$@"
