#!/usr/bin/env bash
set -euo pipefail

# ai-files-setup: interactive one-shot setup for an ai-files-managed git repository.
#
# Must be run from the ROOT of a git repository. Walks through:
#   0) Bootstrap .ai-files/ if missing             (ai-files update files)
#   1) Sync .ai-files/VERSION from dist if stale   (ai-files update files)
#   2) Obsidian integration config                 (ai-files config [setup])
#   3) Relink agent folders                        (ai-files update link-*)
#   4) Initialize graphify                         (copy .graphifyignore)
#      + select graphify backend/model             (git config aifiles.graphify-*)
#   5) Create missing dotfile templates            (.mcp.json, opencode.json, zcode.json)
#   6) Register known MCP servers when missing     (ai-files mcp add <name>)
#      + shared memory DB proposal for nested checkouts (<repo>/<clone>)
#      + memory DB path validation (env MCP_MEMORY_SQLITE_PATH vs aifiles.memory-db-path)
#      + CodeGraph initialization when 'codegraph' MCP server is registered
#   7) Suggest .gitignore for untracked setup files

# Resolve the real path of the script, even if invoked via symlink (same as bin/ai-files).
SCRIPT_PATH="$0"
while [ -h "$SCRIPT_PATH" ]; do
    DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$DIR/$SCRIPT_PATH"
done
SELF_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"

# The ai-files install root (parent of bin/) — where dist/ and the dotfile
# templates (.graphifyignore, .mcp.json, opencode.json, zcode.json) live.
# Derived from the install location, not a hardcoded $HOME, so the command
# works no matter where ai-files is installed. Overridable via env.
AI_FILES_HOME="${AI_FILES_HOME:-$(cd -P "$SELF_DIR/.." && pwd)}"

# Colors
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

print_info()    { echo -e "${BLUE}ℹ️  $1${NC}"; }
print_success() { echo -e "${GREEN}✅ $1${NC}"; }
print_warning() { echo -e "${YELLOW}⚠️  $1${NC}"; }
print_error()   { echo -e "${RED}❌ $1${NC}"; }

# y/N confirm (default no, matching bin/ai-files-config's confirm).
confirm() {
    local prompt="$1"
    local default="${2:-n}"
    local response

    while true; do
        if [ "$default" = "y" ]; then
            read -p "$prompt [Y/n]: " response || response=""
        else
            read -p "$prompt [y/N]: " response || response=""
        fi

        case "$response" in
            [Yy][Ee][Ss]|[Yy]) return 0 ;;
            [Nn][Oo]|[Nn]) return 1 ;;
            "")
                [ "$default" = "y" ] && return 0
                [ "$default" = "n" ] && return 1
                ;;
        esac
        echo "Please answer yes or no."
    done
}

# ai-files-setup may be executed ONLY from the root of a git repository.
# Stricter than ai-files-update's detect_git_root(): we must be *at* the
# top level, not merely somewhere inside a repo.
require_git_root() {
    local toplevel
    if ! toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || [[ -z "$toplevel" ]]; then
        print_error "Not inside a git repository."
        echo "ai-files-setup must be run from the root of a git repository." >&2
        exit 1
    fi
    if [[ "$(cd -P "$toplevel" && pwd)" != "$(cd -P . && pwd)" ]]; then
        print_error "Must be run from the ROOT of the git repository: $toplevel"
        echo "Current directory: $(pwd)" >&2
        exit 1
    fi
}

# Run a subcommand through the ai-files CLI. Prefers the `ai-files` dispatcher
# on PATH; falls back to the sibling script in this install (works even when
# ai-files is not on PATH).
run_ai_files() {
    local sub="$1"
    shift
    if command -v ai-files >/dev/null 2>&1; then
        ai-files "$sub" "$@"
    else
        "${SELF_DIR}/ai-files-${sub}" "$@"
    fi
}

# Step 0: bootstrap .ai-files/ when missing.
step0_bootstrap() {
    if [[ -d ".ai-files" ]]; then
        print_info "[0/7] .ai-files/ present — skipping bootstrap."
        return 0
    fi
    print_warning "[0/7] .ai-files/ is missing — running 'ai-files update files'."
    run_ai_files update files
    print_success "[0/7] .ai-files/ bootstrapped."
}

# Step 1: sync .ai-files/VERSION from dist/ when stale.
step1_version_sync() {
    local local_vf=".ai-files/VERSION"
    local dist_vf="${AI_FILES_HOME}/dist/.ai-files/VERSION"

    if [[ ! -f "$local_vf" ]]; then
        print_warning "[1/7] $local_vf not found — cannot check version."
        return 0
    fi
    if [[ ! -f "$dist_vf" ]]; then
        print_warning "[1/7] dist version file not found ($dist_vf) — skipping version check."
        return 0
    fi

    if cmp -s "$local_vf" "$dist_vf"; then
        local v
        v="$(grep '^VERSION=' "$local_vf" | head -1 || true)"
        print_info "[1/7] VERSION up to date (${v:-matches dist})."
        return 0
    fi

    print_warning "[1/7] .ai-files/VERSION differs from $dist_vf:"
    echo "    repo:  $(grep '^VERSION=' "$local_vf" | head -1 || echo '<missing>')"
    echo "    dist:  $(grep '^VERSION=' "$dist_vf" | head -1 || echo '<missing>')"
    if confirm "Update ai-files setup ('ai-files update files')?"; then
        run_ai_files update files
        print_success "[1/7] ai-files setup updated."
    else
        print_warning "[1/7] Skipping update."
    fi
}

# Keys written by 'ai-files config setup' under the aifiles.* git config section.
OBSIDIAN_KEYS=(vault vault-default-path vault-session-default-path vault-memory-default-path)

# Step 2: obsidian integration config.
step2_obsidian() {
    local missing=()
    local key
    for key in "${OBSIDIAN_KEYS[@]}"; do
        if [[ -z "$(git config --local "aifiles.$key" 2>/dev/null || true)" ]]; then
            missing+=("$key")
        fi
    done

    if [[ ${#missing[@]} -eq 0 ]]; then
        print_info "[2/7] Obsidian integration configured — current config:"
        run_ai_files config
        return 0
    fi

    print_warning "[2/7] Obsidian integration not fully configured (missing: ${missing[*]})."
    if confirm "Configure obsidian integration ('ai-files config setup')?"; then
        run_ai_files config setup
    else
        print_warning "[2/7] Skipping obsidian configuration."
    fi
}

# Step 3: relink agent folders. Only proposed when at least one agent folder is
# missing; otherwise the available link commands are just mentioned.
RELINK_DIRS=(.claude .kilo .opencode .specify)
RELINK_COMMANDS=(link-claude link-kilo link-opencode link-specify)

step3_relink() {
    local missing=()
    local dir cmd
    for dir in "${RELINK_DIRS[@]}"; do
        [[ -d "$dir" ]] || missing+=("$dir")
    done

    if [[ ${#missing[@]} -eq 0 ]]; then
        print_info "[3/7] Agent folders all present. Available commands:"
        for cmd in "${RELINK_COMMANDS[@]}"; do
            echo "    ai-files update $cmd"
        done
        return 0
    fi

    print_warning "[3/7] Missing agent folders: ${missing[*]}."
    if ! confirm "[3/7] Relink agent folders?"; then
        print_warning "[3/7] Skipping relink."
        return 0
    fi
    for cmd in "${RELINK_COMMANDS[@]}"; do
        if confirm "  Run 'ai-files update $cmd -y'?"; then
            if run_ai_files update "$cmd" -y; then
                print_success "  $cmd done."
            else
                print_warning "  '$cmd' reported a failure."
            fi
        else
            print_info "  Skipped $cmd."
        fi
    done
}

# Step 4: initialize graphify (.graphifyignore) and validate the graphify
# backend stored in the repo's git config (aifiles.graphify-backend /
# aifiles.graphify-model — applied automatically by bin/ai-files-graphify).

# Default model offered when the ollama-local backend is selected.
# NOTE: on the ollama registry GLM-5.3 / GLM-5.3-Flash / GLM-5.2 exist ONLY as
# ":cloud" tags (routed to ollama cloud, no local weights) — glm-4.7-flash is
# the newest GLM Flash that actually pulls and runs on a local GPU.
GRAPHIFY_DEFAULT_MODEL="glm-4.7-flash"

# Predefined model choices offered first in the selector (installed ollama
# models are appended dynamically; arbitrary custom names are accepted too).
GRAPHIFY_PRESET_MODELS=(glm-4.7-flash deepseek-coder-v2:latest)

# Built-in graphify backends (graphify's BACKENDS registry); custom providers
# from `graphify provider list` are appended dynamically at selection time.
GRAPHIFY_BUILTIN_BACKENDS=(claude gemini kimi openai deepseek azure bedrock claude-cli ollama)

# Step 4a: initialize graphify when graphify-out/ is absent.
step4_graphify_init() {
    if [[ -d "graphify-out" ]]; then
        print_info "[4/7] graphify-out/ present — skipping."
        return 0
    fi
    if [[ -e ".graphifyignore" ]]; then
        print_info "[4/7] .graphifyignore already present — step completed."
        return 0
    fi

    print_warning "[4/7] graphify-out/ not found."
    if ! confirm "Initialize graphify (copy .graphifyignore to repo root)?"; then
        print_warning "[4/7] Skipping graphify initialization."
        return 0
    fi

    local src="${AI_FILES_HOME}/.graphifyignore"
    if [[ ! -f "$src" ]]; then
        print_error "[4/7] Template not found: $src"
        return 1
    fi
    cp "$src" "./.graphifyignore"
    print_success "[4/7] Copied .graphifyignore to repo root."
}

# Step 4b: validate the graphify backend in repo git config; when unset, offer
# a dynamic selection (built-ins + registered custom providers, ollama-local
# always offered and default). ollama-local additionally asks for the model.
# Pick an ollama model: fzf over presets + installed models when interactive
# (a fully custom typed name is accepted too — fzf --print-query returns the
# query itself when nothing matches; Esc falls back to the default). Without a
# tty (or fzf) it degrades to a plain read prompt with the same default.
select_ollama_model() {
    local candidates=() seen=" " m
    for m in "${GRAPHIFY_PRESET_MODELS[@]}" \
             $(command -v ollama >/dev/null 2>&1 && ollama list </dev/null 2>/dev/null | tail -n +2 | awk '{print $1}'); do
        [[ -z "$m" || "$seen" == *" $m "* ]] && continue
        candidates+=("$m")
        seen="$seen$m "
    done

    if command -v fzf >/dev/null 2>&1 && [[ -t 0 ]]; then
        local out pick
        out="$(printf '%s\n' "${candidates[@]}" \
               | fzf --print-query --prompt='Ollama model> ' \
                 --header='select from list · or type any custom name · Esc = default' \
               2>/dev/null || true)"
        # Last line = selection when one was made, else the typed query;
        # abort (Esc) falls back to the default — never a second prompt.
        pick="$(tail -n 1 <<<"$out" || true)"
        echo "${pick:-$GRAPHIFY_DEFAULT_MODEL}"
        return 0
    fi

    local input=""
    read -p "Ollama model [${GRAPHIFY_DEFAULT_MODEL}]: " input || input=""
    echo "${input:-$GRAPHIFY_DEFAULT_MODEL}"
}

graphify_backend_config() {
    local current model
    current="$(git config --local --get aifiles.graphify-backend 2>/dev/null || true)"
    if [[ -n "$current" ]]; then
        model="$(git config --local --get aifiles.graphify-model 2>/dev/null || true)"
        print_info "[4/7] graphify backend configured: ${current}${model:+ (model: ${model})}"
        return 0
    fi
    if ! command -v graphify >/dev/null 2>&1; then
        print_info "[4/7] graphify not installed (make install-graphify) — skipping backend selection."
        return 0
    fi

    # Dynamic options: built-ins + registered custom providers + ollama-local, deduped.
    # (provider list prints "No custom providers registered." when empty — dropped.)
    local options=() seen=" " opt
    for opt in "${GRAPHIFY_BUILTIN_BACKENDS[@]}" \
               $(graphify provider list </dev/null 2>/dev/null | awk 'NF && $0 !~ /^No / {print $1}') \
               ollama-local; do
        [[ "$seen" == *" $opt "* ]] && continue
        options+=("$opt")
        seen="$seen$opt "
    done

    echo "Select graphify backend:"
    local i default_idx=1
    for i in "${!options[@]}"; do
        echo "  $((i+1))) ${options[$i]}"
        [[ "${options[$i]}" == "ollama-local" ]] && default_idx=$((i+1))
    done

    local choice
    while :; do
        read -p "Backend [${default_idx} = ollama-local]: " choice || choice=""
        [[ -z "$choice" ]] && choice="$default_idx"
        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#options[@]} )); then
            break
        fi
        echo "Please enter a number between 1 and ${#options[@]}."
    done
    local backend="${options[$((choice-1))]}"

    if [[ "$backend" != "ollama-local" ]]; then
        git config --local aifiles.graphify-backend "$backend"
        print_success "[4/7] graphify backend set to '$backend'."
        return 0
    fi

    # ollama-local: pick the model (fzf/read), then validate ollama can really
    # use it: installed, or pulled on the spot; a failed pull re-asks.
    local model="" model_ok=0
    while [[ "$model_ok" -eq 0 ]]; do
        model="$(select_ollama_model)"
        if ! command -v ollama >/dev/null 2>&1; then
            break   # no local ollama to validate against — trust the name
        fi
        if ollama list </dev/null 2>/dev/null | tail -n +2 | awk '{print $1}' | grep -qxF "$model"; then
            model_ok=1
        else
            print_warning "Model '${model}' is not installed locally."
            if confirm "Pull '${model}' now (ollama pull)?"; then
                if ollama pull "$model"; then
                    print_success "Pulled ${model}."
                    model_ok=1
                else
                    print_error "Pull failed — ollama cannot use '${model}'. Pick another model."
                fi
            else
                print_info "Keeping '${model}' unverified (pull later with: ollama pull ${model})."
                model_ok=1
            fi
        fi
    done

    # Register the provider only when absent — respect an existing setup.
    # </dev/null: graphify commands drain inherited stdin, which would
    # otherwise eat the keystrokes meant for the prompts below.
    if ! graphify provider show ollama-local </dev/null >/dev/null 2>&1; then
        graphify provider add ollama-local --base-url http://localhost:11434/v1 \
            --default-model "$model" --env-key OLLAMA_API_KEY < /dev/null
    else
        print_info "[4/7] graphify provider 'ollama-local' already registered — keeping it."
    fi
    git config --local aifiles.graphify-backend "ollama-local"
    git config --local aifiles.graphify-model "$model"
    print_success "[4/7] graphify backend 'ollama-local' (model: ${model}) stored in git config."
    print_info "Use 'bin/ai-files-graphify' — it applies this backend/model automatically."
}

step4_graphify() {
    step4_graphify_init
    graphify_backend_config
}

# Step 5: create missing dotfile templates.
DOTFILE_TEMPLATES=(.mcp.json opencode.json zcode.json)

step5_dotfiles() {
    local f src
    for f in "${DOTFILE_TEMPLATES[@]}"; do
        if [[ -e "$f" ]]; then
            print_info "[5/7] $f present — skipping."
            continue
        fi
        src="${AI_FILES_HOME}/$f"
        if [[ ! -f "$src" ]]; then
            print_warning "[5/7] Template not found for $f: $src"
            continue
        fi
        if confirm "[5/7] Create $f from template?"; then
            cp "$src" "./$f"
            print_success "[5/7] Created $f."
        else
            print_warning "[5/7] Skipped $f."
        fi
    done
}

# Files this setup may create or link that typically should not be tracked.
GITIGNORE_CANDIDATES=(.claude/ .graphifyignore .kilo/ .mcp.json .opencode/ .specify/ opencode.json zcode.json)

# Step 6: register known MCP servers when missing. 'ai-files mcp add <name>'
# writes .mcp.json (primary) and syncs the converted entry into opencode.json
# and zcode.json in one run, so all agent configs stay in step. The server
# catalog lives in ai-files-mcp ('mcp known' / 'mcp has') — this step only
# probes it, so new built-ins are offered without editing setup.
step6_mcp_servers() {
    local known name
    known="$(run_ai_files mcp known 2>/dev/null || true)"
    if [[ -z "$known" ]]; then
        print_warning "[6/7] Cannot query known MCP servers ('ai-files mcp known') — skipping."
        return 0
    fi

    local missing=()
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        if run_ai_files mcp has "$name" >/dev/null 2>&1; then
            continue
        fi
        missing+=("$name")
    done <<< "$known"

    if [[ ${#missing[@]} -eq 0 ]]; then
        print_info "[6/7] Known MCP servers registered — current state:"
        run_ai_files mcp list
    else
        if [[ ! -f ".mcp.json" ]]; then
            print_warning "[6/7] .mcp.json absent — registering a server bootstraps the MCP config files."
        fi
        for name in "${missing[@]}"; do
            if confirm "[6/7] Register '${name}' MCP server (writes .mcp.json, opencode.json, zcode.json)?"; then
                if run_ai_files mcp add "$name"; then
                    print_success "  ${name} registered."
                else
                    print_warning "  Registering '${name}' failed."
                fi
            else
                print_info "  Skipped ${name}."
            fi
        done
    fi

    # Nested checkout (<git-repo-name>/<clone-folder>, matched via remote
    # origin): offer to share the repo-memory database between sibling clones
    # via ../.ai-files-shared/.
    if run_ai_files mcp shared-memory --check >/dev/null 2>&1; then
        print_warning "[6/7] Nested checkout detected ($(basename "$(dirname "$PWD")")/$(basename "$PWD"))."
        if confirm "[6/7] Use shared memory DB at ../.ai-files-shared/memory.db?"; then
            run_ai_files mcp shared-memory -y
        else
            print_info "[6/7] Keeping per-repo memory DB."
        fi
    fi

    # Memory DB path validation on every run: global MCP_MEMORY_SQLITE_PATH /
    # stored aifiles.memory-db-path vs the path the mcp configs actually use.
    # Logic lives in ai-files-mcp ('ai-files mcp memory-path'), same
    # delegation as the shared-memory probe above; ordering gives the global
    # env var the final say over the nested-checkout default.
    if run_ai_files mcp has repo-memory >/dev/null 2>&1; then
        if run_ai_files mcp memory-path --check >/dev/null 2>&1; then
            run_ai_files mcp memory-path -y   # idempotent: seeds/pins aifiles.memory-db-path
        elif confirm "[6/7] Realign MCP configs to the desired memory DB path (MCP_MEMORY_SQLITE_PATH / aifiles.memory-db-path)?"; then
            run_ai_files mcp memory-path -y   # rewrites configs; offers import when both DBs exist
        else
            print_info "[6/7] Keeping current memory DB paths."
        fi
    fi

    # CodeGraph: offer initialization when its MCP server is registered in
    # .mcp.json (possibly just added above). Idempotent guard: .codegraph/
    # already present means the index exists — nothing to initialize.
    if run_ai_files mcp has codegraph >/dev/null 2>&1; then
        if [[ -d ".codegraph" ]]; then
            print_info "[6/7] CodeGraph already initialized (.codegraph/ present)."
        elif ! command -v codegraph >/dev/null 2>&1; then
            print_warning "[6/7] 'codegraph' binary not on PATH — install with 'make install-codegraph' (ai-files repo)."
        elif confirm "[6/7] Initialize CodeGraph for this repo (codegraph install --yes --init --target=auto --location=local)?"; then
            # --yes keeps it unattended: without it codegraph drops into an
            # interactive TUI prompt that would eat this script's piped stdin.
            # Explicit --target/--location flags override the --yes defaults.
            if codegraph install --yes --init --target=auto --location=local; then
                print_success "[6/7] CodeGraph initialized."
            else
                print_warning "[6/7] CodeGraph initialization failed."
            fi
        else
            print_info "[6/7] Skipping CodeGraph initialization."
        fi
    fi
}

# Pick the ignore file: prefer .gitignore.local when it exists as a symlink
# pointing to ./.git/info/exclude; otherwise fall back to .gitignore.
pick_ignore_file() {
    if [[ -L ".gitignore.local" ]]; then
        local target
        target="$(readlink ".gitignore.local" 2>/dev/null || true)"
        if [[ "$target" == ".git/info/exclude" || "$target" == "./.git/info/exclude" ]]; then
            echo ".gitignore.local"
            return 0
        fi
    fi
    echo ".gitignore"
}

# Step 7 (final): if any setup file is untracked, suggest adding it to the
# ignore file (prefers .gitignore.local → ./.git/info/exclude over .gitignore).
step7_gitignore() {
    local untracked
    untracked="$(git status --porcelain | sed -n 's/^?? //p' || true)"

    local found=()
    local c
    for c in "${GITIGNORE_CANDIDATES[@]}"; do
        if grep -qxF "$c" <<< "$untracked"; then
            found+=("$c")
        fi
    done

    if [[ ${#found[@]} -eq 0 ]]; then
        print_info "[7/7] No untracked setup files — nothing to add to the ignore file."
        return 0
    fi

    local ignore_file
    ignore_file="$(pick_ignore_file)"

    print_warning "[7/7] Untracked setup files:"
    local f
    for f in "${found[@]}"; do
        echo "    $f"
    done
    if ! confirm "Add them to ${ignore_file}?"; then
        print_warning "[7/7] Skipping ignore update."
        return 0
    fi

    for c in "${found[@]}"; do
        if [[ -f "$ignore_file" ]] && grep -qxF "$c" "$ignore_file"; then
            print_info "  $c already in $ignore_file."
            continue
        fi
        echo "$c" >> "$ignore_file"
        print_success "  Added $c to $ignore_file."
    done
}

show_usage() {
    cat <<EOF
Usage: ai-files-setup [options]

Interactive setup for an ai-files-managed git repository.
Must be run from the ROOT of a git repository.

Steps:
  0  Bootstrap .ai-files/ if missing             (ai-files update files)
  1  Sync .ai-files/VERSION from dist/ if stale  (ai-files update files)
  2  Obsidian integration config                 (ai-files config [setup])
  3  Relink agent folders                        (ai-files update link-*)
  4  Initialize graphify                         (copy .graphifyignore)
     + select graphify backend/model             (git config aifiles.graphify-*)
  5  Create missing dotfile templates            (.mcp.json, opencode.json, zcode.json)
  6  Register known MCP servers when missing     (.mcp.json / opencode.json / zcode.json)
     + shared memory DB proposal for nested checkouts (<x>/<x>)
     + memory DB path validation (MCP_MEMORY_SQLITE_PATH vs aifiles.memory-db-path)
     + CodeGraph init when 'codegraph' MCP server is registered
  7  Suggest ignore entries for untracked setup files (.gitignore / .gitignore.local)

Options:
  -h, --help   Show this help and exit

Examples:
  ai-files-setup
  ai-files setup
EOF
}

main() {
    case "${1:-}" in
        -h|--help|help)
            show_usage
            exit 0
            ;;
    esac

    require_git_root

    echo ""
    echo "=== ai-files setup ==="
    echo "Repo root:    $(pwd)"
    echo "ai-files home: $AI_FILES_HOME"
    echo ""

    step0_bootstrap
    step1_version_sync
    step2_obsidian
    step3_relink
    step4_graphify
    step5_dotfiles
    step6_mcp_servers
    step7_gitignore

    echo ""
    print_success "Setup complete."
}

main "$@"
