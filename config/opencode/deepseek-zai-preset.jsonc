{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "preset": "deepseek-zai",
  "presets": {
    "deepseek-zai": {
      "orchestrator": {
        "model": "deepseek/deepseek-v4-pro",
        "variant": "high",
        "skills": ["*", "!make-interfaces-feel-better"],
        "mcps": ["*", "!context7", "!gh_app", "!repo_memory"]
      },
      "oracle": {
        "model": "zai-coding-plan/glm-5-turbo",
        "variant": "high",
        "skills": ["ce-brainstorm", "workers-best-practices", "web-perf"],
        "mcps": ["codegraph", "searxng", "crawl4ai","repo_memory"]
      },
      "librarian": {
        "model": "deepseek/deepseek-v4-flash",
        "variant": "low",
        "skills": ["customer-research"],
        "mcps": ["context7", "gh_app", "searxng", "crawl4ai"]
      },
      "explorer": {
        "model": "deepseek/deepseek-v4-flash",
        "variant": "low",
        "skills": [],
        "mcps": ["codegraph","repo_memory"]
      },
      "designer": {
        "model": "zai-coding-plan/glm-5-turbo",
        "variant": "medium",
        "skills": [
          "make-interfaces-feel-better",
          "better-icons",
          "vue",
          "nuxt",
          "motion",
          "image",
          "marketing-psychology",
          "video"
        ],
        "mcps": ["codegraph"]
      },
      "fixer": {
        "model": "zai-coding-plan/glm-5.2",
        "variant": "high",
        "skills": ["vitest", "pnpm", "vite", "tsdown"],
        "mcps": ["codegraph", "searxng", "crawl4ai","repo_memory"]
      }
    }
  },
  "multiplexer": {
    "type": "kitty",
    "socket": "/dev/shm/kitty",
    "layout": "tiled"
  },
  "companion": {
    "enabled": true,
    "position": "bottom-right",
    "size": "medium",
    "gifPack": "default",
    "loopStyle": "classic",
    "speed": 1,
    "debug": false
  }
}
