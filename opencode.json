{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git add": "ask",
      "git branch": "allow",
      "git checkout": "ask",
      "git cherry-pick": "deny",
      "git commit": "ask",
      "git diff": "allow",
      "git fetch": "allow",
      "git log": "allow",
      "git merge": "ask",
      "git mv": "ask",
      "git pull": "ask",
      "git push": "ask",
      "git rebase": "ask",
      "git reset": "ask",
      "git revert": "ask",
      "git rm": "ask",
      "git show": "allow",
      "git stash": "deny",
      "git status": "allow",
      "git tag": "allow",
      "mv": "ask",
      "rm": "ask"
    },
    "edit": {
      ".ai-files/**": "allow"
    },
    "repo-memory_*": "allow"
  },
  "lsp": true,
  "mcp": {
    "repo-memory": {
      "type": "local",
      "command": [
        "memory",
        "server"
      ],
      "enabled": true,
      "environment": {
        "MCP_MEMORY_SQLITE_PATH": ".ai-files/memory.db",
        "MCP_MEMORY_STORAGE_BACKEND": "sqlite_vec",
        "MCP_ALLOW_ANONYMOUS_ACCESS": "true",
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}
